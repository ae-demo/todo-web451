{
  "version": 1,
  "coldStartRole": "Employee",
  "publicComponents": [],
  "roles": [
    {
      "name": "Employee",
      "description": "Submits expense claims, attaches receipts, tracks claim status, and edits and resubmits rejected claims.",
      "stories": [1, 2, 3, 4, 5],
      "grantedBy": "first sign-in",
      "permissions": [
        { "component": "expense-api", "actions": ["create claim", "read own claims", "update own claim"] },
        { "component": "expense-webapp", "screens": ["My Claims", "Submit Claim", "Claim Detail"] }
      ]
    },
    {
      "name": "Manager",
      "description": "Reviews claims submitted by their direct reports and approves or rejects each one.",
      "stories": [6, 7],
      "grantedBy": "Admin",
      "permissions": [
        { "component": "expense-api", "actions": ["read direct reports' claims", "approve claim", "reject claim"] },
        { "component": "expense-webapp", "screens": ["Approvals"] }
      ]
    },
    {
      "name": "Finance",
      "description": "Reviews approved expense claims across the organization and exports them for payroll.",
      "stories": [8, 9, 10],
      "grantedBy": "Admin",
      "permissions": [
        { "component": "expense-api", "actions": ["read approved claims", "export claims"] },
        { "component": "expense-webapp", "screens": ["Approved Claims", "Export"] }
      ]
    },
    {
      "name": "Admin",
      "description": "Manages the compliance catalog and manages users and their role assignments; full visibility across the hub.",
      "stories": [11, 12],
      "grantedBy": "Admin",
      "permissions": [
        { "component": "expense-api", "actions": ["assign manager", "manage categories"] },
        { "component": "expense-webapp", "screens": ["Manager Assignments", "Categories"] }
      ]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "role": "Employee" },
    { "username": "test-manager", "role": "Manager" },
    { "username": "test-finance", "role": "Finance" },
    { "username": "test-admin", "role": "Admin" }
  ],
  "thunder": {
    "name": "Expense Claims",
    "type": "browser",
    "scopes": "openid profile email group ou"
  }
}
